# =============================================================================
# TrustHire AI — Server Environment (Tailscale IP: 100.100.10.10)
# Place this file at: /home/trusthire/TrustHire-AI/deploy/server.env
# Permissions: chmod 600 deploy/server.env
# =============================================================================

# ── Required: Signing secret ─────────────────────────────────────────────────
# Generate one: openssl rand -hex 32
# Replace the value below with your actual secret
TRUSTHIRE_SIGNING_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── Frontend/Backend URLs ─────────────────────────────────────────────────────
# Next.js rewrites /api/* → localhost:8080 internally,
# so the browser always calls relative /api (no hostname crossing)
NEXT_PUBLIC_API_BASE_URL=/api

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to wherever browsers will open the app from.
#
# Option A — Tailscale network only (private, accessible to tailnet members):
TRUSTHIRE_CORS_ORIGIN=http://100.100.10.10:3000
#
# Option B — Tailscale Funnel (public HTTPS via *.ts.net domain)
# Uncomment this and comment Option A after running:
#   sudo tailscale funnel --bg 3000
#   tailscale status   (copy the DNSName field)
# TRUSTHIRE_CORS_ORIGIN=https://YOUR_MACHINE_NAME.ts.net

# ── Ollama ───────────────────────────────────────────────────────────────────
TRUSTHIRE_OLLAMA_URL=http://localhost:11434
TRUSTHIRE_OLLAMA_MODEL=llama3.2

# ── Project root (set automatically by deploy.sh — do not change) ─────────────
TRUSTHIRE_PROJECT_ROOT=/home/trusthire/TrustHire-AI
