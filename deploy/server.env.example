# =============================================================================
# TrustHire AI — Server environment config
# Copy this to deploy/server.env and fill in your real values.
# This file is in .gitignore — NEVER commit server.env with real secrets.
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# HMAC signing secret for eligibility results and receipts.
# Generate: openssl rand -hex 32
TRUSTHIRE_SIGNING_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# With the Next.js rewrite proxy, the frontend calls /api/* relative to itself.
# Next.js then proxies those requests to Spring Boot on localhost:8080 on the server.
# So set this to just /api (no hostname needed in production).
NEXT_PUBLIC_API_BASE_URL=/api

# The origin the browser sends — must match what Tailscale Funnel exposes
# Example: https://rudra-server.tail1234ab.ts.net  OR  https://YOUR_MACHINE.ts.net
TRUSTHIRE_CORS_ORIGIN=https://YOUR_MACHINE_NAME.ts.net

# ── Optional — Ollama ─────────────────────────────────────────────────────────

# Where Ollama is listening (default: local)
TRUSTHIRE_OLLAMA_URL=http://localhost:11434

# Which model to use
TRUSTHIRE_OLLAMA_MODEL=llama3.2

# ── Set automatically by deploy.sh — do not edit manually ─────────────────────
# TRUSTHIRE_PROJECT_ROOT=/home/trusthire/TrustHire-AI
